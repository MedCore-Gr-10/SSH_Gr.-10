generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model allergies {
  id           Int     @id @default(autoincrement())
  patient_id   String? @db.Uuid
  allergy_name String? @db.VarChar(50)
  users        users?  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([patient_id, allergy_name])
}

model appointments_booking_slots {
  id                              Int                     @id @default(autoincrement())
  doctor_id                       String?                 @db.Uuid
  appointment_template_id         Int?
  appointment_date                DateTime                @db.Date
  active_appointment_booking_slot Boolean?                @default(true)
  appointments_templates          appointments_templates? @relation(fields: [appointment_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                           users?                  @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments_made               appointments_made[]
}

model appointments_made {
  id                          Int                         @id @default(autoincrement())
  appointment_booking_slot_id Int?
  patient_id                  String?                     @db.Uuid
  active_appointment_made     Boolean?                    @default(true)
  appointments_booking_slots  appointments_booking_slots? @relation(fields: [appointment_booking_slot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                       users?                      @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  diagnoses                   diagnoses[]
  prescriptions               prescriptions[]
}

model appointments_templates {
  id                          Int                          @id @default(autoincrement())
  staff_id                    String?                      @db.Uuid
  hospital_id                 Int?
  department_id               Int?
  day_of_week                 String?                      @db.VarChar(10)
  start_time                  DateTime                     @db.Time(6)
  end_time                    DateTime                     @db.Time(6)
  active_appointment_template Boolean?                     @default(true)
  appointments_booking_slots  appointments_booking_slots[]
  staff_hospitals_departments staff_hospitals_departments? @relation(fields: [staff_id, hospital_id, department_id], references: [staff_id, hospital_id, department_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staff_id, hospital_id, department_id, day_of_week, start_time])
}

model departments {
  id                    Int                     @id @default(autoincrement())
  department_name       String                  @unique @db.VarChar(50)
  hospitals_departments hospitals_departments[]
}

model diagnoses {
  id                  Int                @id @default(autoincrement())
  appointment_made_id Int?
  diagnosis           String
  created_at          DateTime?          @default(now()) @db.Timestamp(6)
  appointments_made   appointments_made? @relation(fields: [appointment_made_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model emergency_contacts {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id   String? @db.Uuid
  contact_name String  @db.VarChar(100)
  relationship String? @db.VarChar(50)
  phone_number String?
  users        users?  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([patient_id, phone_number])
}

model hospitals {
  id                    Int                     @id @default(autoincrement())
  hospital_name         String?                 @db.VarChar(50)
  hospital_address      String?
  email                 String                  @unique
  hospitals_departments hospitals_departments[]
  patients_hospitals    patients_hospitals[]

  @@unique([hospital_name, hospital_address])
}

model hospitals_departments {
  hospital_id                 Int
  department_id               Int
  departments                 departments                 @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hospitals                   hospitals                   @relation(fields: [hospital_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_hospitals_departments staff_hospitals_departments[]

  @@id([hospital_id, department_id])
}

model insurance {
  id               Int       @id @default(autoincrement())
  patient_id       String?   @db.Uuid
  provider         String?
  policy_number    String?
  coverage_percent Int?
  start_date       DateTime? @db.Date
  end_date         DateTime? @db.Date
  users            users?    @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model patients_hospitals {
  patient_id  String    @db.Uuid
  hospital_id Int
  hospitals   hospitals @relation(fields: [hospital_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([patient_id, hospital_id])
}

model prescriptions {
  id                  Int                @id @default(autoincrement())
  appointment_made_id Int?
  medication_name     String
  dosage              String?
  instructions        String?
  created_at          DateTime?          @default(now()) @db.Timestamp(6)
  appointments_made   appointments_made? @relation(fields: [appointment_made_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model profiles {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name     String?          @db.VarChar(50)
  last_name      String?          @db.VarChar(50)
  birth          DateTime?        @db.Date
  gender         String?
  personal_no    String?          @unique
  phone_number   String?
  users_profiles users_profiles[]
}

model reviews {
  id                              Int     @id @default(autoincrement())
  patient_id                      String? @db.Uuid
  doctor_id                       String? @db.Uuid
  rating                          Int?
  comment                         String?
  users_reviews_doctor_idTousers  users?  @relation("reviews_doctor_idTousers", fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_reviews_patient_idTousers users?  @relation("reviews_patient_idTousers", fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([patient_id, doctor_id])
}

model roles {
  id        Int     @id @default(autoincrement())
  role_name String  @unique @db.VarChar(50)
  users     users[]
}

model specializations {
  id                    Int                     @id @default(autoincrement())
  specialization_name   String                  @unique @db.VarChar(100)
  staff_specializations staff_specializations[]
}

model staff_hospitals_departments {
  staff_id                String                    @db.Uuid
  hospital_id             Int
  department_id           Int
  appointments_templates  appointments_templates[]
  hospitals_departments   hospitals_departments     @relation(fields: [hospital_id, department_id], references: [hospital_id, department_id], onDelete: Cascade, onUpdate: NoAction)
  users                   users                     @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_specializations   staff_specializations[]
  staff_working_schedules staff_working_schedules[]

  @@id([staff_id, hospital_id, department_id])
}

model staff_specializations {
  staff_id                    String                      @db.Uuid
  hospital_id                 Int
  department_id               Int
  specialization_id           Int
  specializations             specializations             @relation(fields: [specialization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_hospitals_departments staff_hospitals_departments @relation(fields: [staff_id, hospital_id, department_id], references: [staff_id, hospital_id, department_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([staff_id, hospital_id, department_id, specialization_id])
}

model staff_working_schedules {
  id                          Int                          @id @default(autoincrement())
  staff_id                    String?                      @db.Uuid
  hospital_id                 Int?
  department_id               Int?
  day_of_week                 String?                      @db.VarChar(10)
  start_time                  DateTime                     @db.Time(6)
  end_time                    DateTime                     @db.Time(6)
  created_at                  DateTime?                    @default(now()) @db.Timestamp(6)
  active_schedule             Boolean?                     @default(true)
  staff_hospitals_departments staff_hospitals_departments? @relation(fields: [staff_id, hospital_id, department_id], references: [staff_id, hospital_id, department_id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                          String                        @unique @db.VarChar(50)
  hash_password                     String
  salt                              String?
  role_id                           Int?
  is_active                         Boolean                       @default(true)
  allergies                         allergies[]
  appointments_booking_slots        appointments_booking_slots[]
  appointments_made                 appointments_made[]
  emergency_contacts                emergency_contacts[]
  insurance                         insurance[]
  patients_hospitals                patients_hospitals[]
  reviews_reviews_doctor_idTousers  reviews[]                     @relation("reviews_doctor_idTousers")
  reviews_reviews_patient_idTousers reviews[]                     @relation("reviews_patient_idTousers")
  staff_hospitals_departments       staff_hospitals_departments[]
  roles                             roles?                        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_profiles                    users_profiles[]
  logs                              logs[]
  sent_requests                     requests[]                    @relation("SentRequests")
  received_requests                 requests[]                    @relation("ReceivedRequests")
}

model users_profiles {
  user_id    String   @db.Uuid
  profile_id String   @db.Uuid
  email      String   @unique
  profiles   profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, profile_id])
}

model logs {
  id        Int      @id @default(autoincrement())
  user_id   String   @db.Uuid
  action    String
  timestamp DateTime @default(now())
  reason    String?
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model requests {
  id          Int      @id @default(autoincrement())
  sender_id   String   @db.Uuid
  receiver_id String   @db.Uuid
  message     String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  sender      users    @relation("SentRequests", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver    users    @relation("ReceivedRequests", fields: [receiver_id], references: [id], onDelete: Cascade)
}